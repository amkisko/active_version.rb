<div class="card">
  <div class="av-flex av-flex-between" style="margin-bottom: var(--av-space-lg);">
    <h2 style="margin-bottom: 0; padding-bottom: 0; border-bottom: none;"><%= @issue.title %></h2>
    <div class="av-action-row">
      <%= link_to "Edit", edit_issue_path(@issue), class: "btn" %>
      <%= link_to "Back", issues_path, class: "btn btn-secondary" %>
    </div>
  </div>

  <div class="tabs">
    <button class="tab active" onclick="showIssueTab('content')">Content</button>
    <button class="tab" onclick="showIssueTab('translations')">Translations</button>
    <button class="tab" onclick="showIssueTab('revisions')">Revisions</button>
    <button class="tab" onclick="showIssueTab('audits')">Audits</button>
  </div>

  <div id="content" class="tab-content active">
    <p><strong>Status:</strong> <%= @issue.status %></p>
    <p><strong>Labels:</strong> <%= @issue.labels_csv.presence || "—" %></p>
    <p><strong>Author:</strong> <%= @issue.author&.name || "—" %></p>
    <p><strong>Assignee:</strong> <%= @issue.assignee&.name || "—" %></p>
    <p><strong>Body:</strong><br><%= simple_format(@issue.body) %></p>
    <p><strong>Attachment:</strong>
      <% if @issue.attachment.present? %>
        <%= link_to attachment_label(@issue), @issue.attachment_url, target: "_blank", rel: "noopener" %>
      <% else %>
        —
      <% end %>
    </p>
  </div>

  <div id="translations" class="tab-content">
    <%= link_to "Manage Translations", translations_issue_path(@issue), class: "btn" %>
  </div>

  <div id="revisions" class="tab-content">
    <%= link_to "View Revisions", revisions_issue_path(@issue), class: "btn" %>
  </div>

  <div id="audits" class="tab-content">
    <%= link_to "View Audits", audits_issue_path(@issue), class: "btn" %>
  </div>
</div>

<script>
  function showIssueTab(tabName) {
    document.querySelectorAll('.tab-content').forEach((tab) => tab.classList.remove('active'));
    document.querySelectorAll('.tab').forEach((tab) => tab.classList.remove('active'));
    document.getElementById(tabName).classList.add('active');
    event.target.classList.add('active');
  }
</script>
