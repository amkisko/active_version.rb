<div class="card">
  <h2>Issue Translations: <%= @issue.title %></h2>
  <%= link_to "Back to Issue", issue_path(@issue), class: "btn btn-secondary" %>

  <div class="tabs" style="margin-top: 20px;">
    <% @available_locales.each do |locale| %>
      <button class="tab <%= 'active' if locale.to_s == @current_locale.to_s %>" onclick="showIssueLocale('<%= locale %>')"><%= locale.to_s.upcase %></button>
    <% end %>
  </div>

  <% @available_locales.each do |locale| %>
    <div id="issue-locale-<%= locale %>" class="tab-content <%= 'active' if locale.to_s == @current_locale.to_s %>">
      <% translation = @issue.translations.find_or_initialize_by(locale: locale) %>
      <%= form_with model: translation, url: translations_issue_path(@issue), method: :patch, local: true do |f| %>
        <%= f.hidden_field :locale, value: locale %>
        <div class="form-group"><%= f.label :title, "Title (#{locale})" %><%= f.text_field :title, value: translation.persisted? ? translation.title : @issue.translate(:title, locale: locale) %></div>
        <div class="form-group"><%= f.label :body, "Body (#{locale})" %><%= f.text_area :body, value: translation.persisted? ? translation.body : @issue.translate(:body, locale: locale) %></div>
        <div class="form-group"><%= f.label :labels_csv, "Labels (#{locale})" %><%= f.text_field :labels_csv, value: translation.labels_csv %></div>
        <div class="form-group"><%= f.label :attachment, "Attachment (#{locale})" %><%= f.file_field :attachment %></div>
        <%= f.submit "Save Translation", class: "btn btn-success" %>
      <% end %>
    </div>
  <% end %>
</div>

<script>
  function showIssueLocale(locale) {
    document.querySelectorAll('.tab-content').forEach((tab) => tab.classList.remove('active'));
    document.querySelectorAll('.tab').forEach((tab) => tab.classList.remove('active'));
    document.getElementById('issue-locale-' + locale).classList.add('active');
    event.target.classList.add('active');
  }
</script>
