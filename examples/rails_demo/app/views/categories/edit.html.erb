<div class="card">
  <h2>Edit Category</h2>

  <%= form_with model: @category, local: true do |f| %>
    <div class="form-group">
      <%= f.label :name %>
      <%= f.text_field :name, required: true %>
    </div>

    <div class="form-group">
      <%= f.submit "Update Category", class: "btn btn-success" %>
      <%= link_to "Cancel", @category, class: "btn btn-secondary" %>
    </div>
  <% end %>
</div>

