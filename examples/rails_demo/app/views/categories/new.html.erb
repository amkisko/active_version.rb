<div class="card">
  <h2>New Category</h2>
  <% token = demo_prefill_token("cat") %>

  <%= form_with model: @category, local: true do |f| %>
    <div class="form-group">
      <%= f.label :name %>
      <%= f.text_field :name, required: true, value: (@category.name.presence || "Category #{token}") %>
    </div>

    <div class="form-group">
      <%= f.submit "Create Category", class: "btn btn-success" %>
      <%= link_to "Cancel", categories_path, class: "btn btn-secondary" %>
    </div>
  <% end %>
</div>
